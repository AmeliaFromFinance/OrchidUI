<Project Sdk="Microsoft.NET.Sdk">

  <!-- orchid-host on Avalonia's headless platform: rendering, input, accessibility, snapshots,
       and the real shim talking to the real host over a pipe and loopback TCP. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CS8632;xUnit1031;xUnit1051;CA1416</NoWarn>
    <DefineConstants>$(DefineConstants);ORCHID_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12.1 is built against xunit.v3 3.2; xunit 4 changed the API it calls. -->
    <PackageReference Include="xunit.v3.mtp-v2" VersionOverride="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrchidUI.Host\OrchidUI.Host.csproj" />
    <!-- The shim and the fake CPH, under aliases: both compile the shared protocol source. -->
    <ProjectReference Include="..\..\src\OrchidUI\OrchidUI.csproj" Aliases="shim" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\tools\orchid-sandbox\orchid-sandbox.csproj" Aliases="sandbox" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
