<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OrchidUI.dll: the public API for Streamer.bot actions. The net481 build is the one users get
    (one file, no dependencies, same as Streamer.bot). The net10.0 build exists only so the shim can be
    tested on Linux and macOS, where .NET Framework doesn't run.
  -->
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>OrchidUI</AssemblyName>
    <RootNamespace>OrchidUI</RootNamespace>
    <Product>OrchidUI</Product>
    <Description>Settings windows for Streamer.bot extensions, drawn natively on Windows, Linux and macOS.</Description>
    <DebugType>embedded</DebugType>
    <IsPackable>false</IsPackable>
    <!-- CA1416: Registry and pipe ACL calls are guarded by runtime OS checks. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OrchidUI.Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrchidUI.Tests" />
    <InternalsVisibleTo Include="orchid-sandbox" />
  </ItemGroup>

</Project>
